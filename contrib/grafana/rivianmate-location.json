          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT MAX(ts) AS time, COUNT(*) AS value FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} AND $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "title": "Points in Range",
      "type": "stat"
