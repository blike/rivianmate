            "filterData": {
              "id": "byRefId",
              "options": "A"
            }
          },
          {
            "type": "markers",
            "name": "Saved locations",
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "fixed": "blue"
                },
                "opacity": 1,
                "size": {
                  "fixed": 12,
                  "min": 2,
                  "max": 15
                },
                "symbol": {
                  "fixed": "img/icons/marker/star.svg",
                  "mode": "fixed"
                },
                "text": {
                  "field": "name",
                  "fixed": "",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": -14,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "tooltip": true
          }
        ],
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 12
        }
      },
