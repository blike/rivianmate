          "rawQuery": true,
          "rawSql": "SELECT ts AS time, altitude * (CASE WHEN '${dist}' = 'km' THEN 1 ELSE 3.28084 END) AS \"value [${elev_u}]\" FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} AND altitude IS NOT NULL ORDER BY ts DESC LIMIT 1",
          "refId": "A"
