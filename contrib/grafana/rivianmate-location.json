          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts, lat, lon, speed_kmh FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} AND $__timeFilter(ts) ORDER BY ts DESC LIMIT 2000",
          "refId": "A"
