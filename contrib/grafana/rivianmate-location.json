      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Time\", lat AS \"Latitude\", lon AS \"Longitude\", speed_kmh * (CASE WHEN '${dist}' = 'km' THEN 1 ELSE 0.621371 END) AS \"Speed [${speed_u}]\", bearing AS \"Bearing\", altitude * (CASE WHEN '${dist}' = 'km' THEN 1 ELSE 3.28084 END) AS \"Altitude [${elev_u}]\" FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} ORDER BY ts DESC LIMIT 100",
          "refId": "A"
        }
