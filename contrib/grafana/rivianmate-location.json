{
  "description": "Live map track and recent location points for your vehicle.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["rivianmate"],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[mph\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitymph"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[km/h\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 301,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, COALESCE(speed_kmh, 0) * (CASE WHEN '${dist}' = 'km' THEN 1 ELSE 0.621371 END) AS \"value [${speed_u}]\" FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Current Speed",
      "type": "stat",
      "description": "Speed at the latest GPS point; a parked car's missing speed reads 0. R2 speeds before 2026-10-14 are unreliable."
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
