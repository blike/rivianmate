          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, bearing AS value FROM location_points WHERE vehicle_id = ${vehicle:sqlstring} AND bearing IS NOT NULL ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Bearing",
      "type": "stat",
      "description": "Heading at the latest GPS point that recorded one."
