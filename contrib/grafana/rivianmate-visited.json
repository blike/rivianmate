{
  "description": "Heatmap of everywhere the vehicle has been \u2014 no named places without a geofence table.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["rivianmate"],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1001,
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "blur": 15,
              "opacity": 0.6,
              "radius": 12,
              "weight": {
                "fixed": 0.5
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Visited",
            "type": "heatmap",
            "filterData": {
              "id": "byRefId",
              "options": "A"
            }
          },
          {
            "type": "markers",
            "name": "Saved locations",
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": false,
              "style": {
                "color": {
                  "fixed": "blue"
                },
                "opacity": 1,
                "size": {
                  "fixed": 12,
                  "min": 2,
                  "max": 15
                },
                "symbol": {
                  "fixed": "img/icons/marker/star.svg",
                  "mode": "fixed"
                },
                "text": {
                  "field": "name",
                  "fixed": "",
                  "mode": "field"
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": -14,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "tooltip": true
          }
        ],
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lat, lon FROM location_points WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 5000",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lat, lon, name FROM saved_locations",
          "refId": "B"
        }
      ],
      "title": "Visited Areas (Heatmap)",
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 1002,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT end_lat AS \"Latitude\", end_lon AS \"Longitude\", COUNT(*) AS \"Times\" FROM drives WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND (distance_km IS NULL OR distance_km >= 0.1) AND end_lat IS NOT NULL GROUP BY end_lat, end_lon ORDER BY COUNT(*) DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Most Common Drive End Points",
      "type": "table"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": ["rivianmate"],
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Visited",
  "uid": "rivianmate-visited",
  "version": 1,
  "id": null,
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "grafana-postgresql-datasource",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  }
}
