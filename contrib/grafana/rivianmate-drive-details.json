        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT distance_km*(CASE WHEN '${dist}' = 'km' THEN 1 ELSE 0.621371 END) AS \"value [${dist}]\" FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Distance",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
