      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 6,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((distance_km * (CASE WHEN '${dist}' = 'km' THEN 1 ELSE 0.621371 END) / NULLIF(EXTRACT(EPOCH FROM (COALESCE(ended_at, now()) - started_at))/3600.0, 0))::numeric, 1) AS \"value [${speed_u}]\" FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Avg Speed",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[mi/kWh\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: mi/kWh"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[kWh/100 km\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: kWh/100 km"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 0
      },
      "id": 16,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT (CASE WHEN ((start_battery - end_battery) * battery_capacity_kwh / 100) > 0 AND (distance_km) > 0 THEN CASE WHEN '${dist}' = 'km' THEN ((start_battery - end_battery) * battery_capacity_kwh / 100) * 100 / (distance_km) ELSE (distance_km) * 0.621371 / ((start_battery - end_battery) * battery_capacity_kwh / 100) END END) AS \"value [${eff_u}]\" FROM drives WHERE id=$drive_id"
        }
      ],
      "title": "Efficiency (est.)",
      "type": "stat",
      "description": "Battery % used x pack capacity per distance, so it includes climate and other loads. Short drives are noisy (distance is whole km, battery 0.1 %)."
    },
