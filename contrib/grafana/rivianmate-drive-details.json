        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[mph\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitymph"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*\\[km/h\\]$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "velocitykmh"
              }
            ]
