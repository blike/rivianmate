      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id AS \"Drive ID\", started_at AS \"Started\", ended_at AS \"Ended\", ROUND(EXTRACT(EPOCH FROM (COALESCE(ended_at, now()) - started_at))/60.0) AS \"Duration (min)\", COALESCE((SELECT sl.name FROM saved_locations sl WHERE start_lat IS NOT NULL AND start_lon IS NOT NULL AND 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(sl.lat - start_lat) / 2), 2) + COS(RADIANS(start_lat)) * COS(RADIANS(sl.lat)) * POWER(SIN(RADIANS(sl.lon - start_lon) / 2), 2))) <= sl.radius_m / 1000.0 ORDER BY 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(sl.lat - start_lat) / 2), 2) + COS(RADIANS(start_lat)) * COS(RADIANS(sl.lat)) * POWER(SIN(RADIANS(sl.lon - start_lon) / 2), 2))) / (sl.radius_m / 1000.0), sl.id DESC LIMIT 1), CASE WHEN EXISTS (SELECT 1 FROM wallboxes w WHERE start_lat IS NOT NULL AND w.latitude IS NOT NULL AND w.longitude IS NOT NULL AND 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(w.latitude - start_lat) / 2), 2) + COS(RADIANS(start_lat)) * COS(RADIANS(w.latitude)) * POWER(SIN(RADIANS(w.longitude - start_lon) / 2), 2))) <= 0.15) THEN 'Home' END, start_place) AS \"From\", COALESCE((SELECT sl.name FROM saved_locations sl WHERE end_lat IS NOT NULL AND end_lon IS NOT NULL AND 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(sl.lat - end_lat) / 2), 2) + COS(RADIANS(end_lat)) * COS(RADIANS(sl.lat)) * POWER(SIN(RADIANS(sl.lon - end_lon) / 2), 2))) <= sl.radius_m / 1000.0 ORDER BY 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(sl.lat - end_lat) / 2), 2) + COS(RADIANS(end_lat)) * COS(RADIANS(sl.lat)) * POWER(SIN(RADIANS(sl.lon - end_lon) / 2), 2))) / (sl.radius_m / 1000.0), sl.id DESC LIMIT 1), CASE WHEN EXISTS (SELECT 1 FROM wallboxes w WHERE end_lat IS NOT NULL AND w.latitude IS NOT NULL AND w.longitude IS NOT NULL AND 6371 * 2 * ASIN(SQRT(POWER(SIN(RADIANS(w.latitude - end_lat) / 2), 2) + COS(RADIANS(end_lat)) * COS(RADIANS(w.latitude)) * POWER(SIN(RADIANS(w.longitude - end_lon) / 2), 2))) <= 0.15) THEN 'Home' END, end_place) AS \"To\", distance_km*0.621371 AS \"Distance (mi)\", ROUND((elevation_gain_m*3.28084)::numeric) AS \"Climb (ft)\", start_battery AS \"Start Batt %\", end_battery AS \"End Batt %\", ROUND((start_battery-end_battery)::numeric, 1) AS \"Batt Used %\" FROM drives WHERE vehicle_id=${vehicle:sqlstring} AND (distance_km IS NULL OR distance_km >= 0.1) ORDER BY started_at DESC",
          "refId": "A"
        }
      ],
      "title": "Drive History",
      "type": "table"
    },
