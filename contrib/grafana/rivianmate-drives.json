          "rawSql": "SELECT started_at AS time, (start_battery-end_battery) AS \"Battery Used (%)\" FROM drives WHERE vehicle_id=${vehicle:sqlstring} AND (distance_km IS NULL OR distance_km >= 0.1) AND $__timeFilter(started_at) ORDER BY started_at",
          "refId": "A"
