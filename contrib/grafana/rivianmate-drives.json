              "url": "/d/rivianmate-drive-details/rivianmate-drive-details?var-vehicle=${vehicle}&var-drive_id=${__data.fields[\"Drive ID\"]}"
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Drive ID"
            },
            "properties": [
