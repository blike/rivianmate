{
  "__inputs": [
    {
      "name": "DS_RIVIANMATE",
      "label": "RivianMate Postgres",
      "description": "The Postgres datasource pointing at rivianmate's own database (same DATABASE_URL the app itself uses).",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "description": "Live map track and recent location points for the simulated R1T.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rivianmate"
      ],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 301,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, speed_kmh AS value FROM location_points ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Current Speed",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "degree"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 302,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, bearing AS value FROM location_points ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Bearing",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "lengthm"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 303,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, altitude AS value FROM location_points ORDER BY ts DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Altitude",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 304,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT MAX(ts) AS time, COUNT(*) AS value FROM location_points WHERE $__timeFilter(ts)",
          "refId": "A"
        }
      ],
      "title": "Points in Range",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "speed_kmh"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 305,
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "speed_kmh",
                  "fixed": "dark-green"
                },
                "opacity": 0.8,
                "size": {
                  "fixed": 5,
                  "max": 10,
                  "min": 2
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                }
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Route",
            "type": "markers"
          }
        ],
        "view": {
          "id": "fitData",
          "lat": 0,
          "lon": 0,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts, lat, lon, speed_kmh FROM location_points WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 2000",
          "refId": "A"
        }
      ],
      "title": "Vehicle Location Track",
      "type": "geomap"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 306,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Time\", lat AS \"Latitude\", lon AS \"Longitude\", speed_kmh AS \"Speed (km/h)\", bearing AS \"Bearing\", altitude AS \"Altitude (m)\" FROM location_points ORDER BY ts DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Recent Location Points",
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "rivianmate"
  ],
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Location",
  "uid": "rivianmate-location",
  "version": 1
}
