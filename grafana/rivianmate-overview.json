{
  "__inputs": [
    {
      "name": "DS_RIVIANMATE",
      "label": "RivianMate Postgres",
      "description": "The Postgres datasource pointing at rivianmate's own database (same DATABASE_URL the app itself uses).",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "state-timeline",
      "name": "State timeline",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "description": "Live status, battery, range and state history for the simulated Rivian R1T.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rivianmate"
      ],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 50
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, battery_level AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Battery Level",
      "type": "gauge"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "lengthmi"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, range_km*0.621371 AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Range",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "lengthmi"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, mileage_m*0.000621371 AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Odometer",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "celsius"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, cabin_temp AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Cabin Temp",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "options": {
                "go": {
                  "color": "green",
                  "text": "Driving"
                },
                "standby": {
                  "color": "blue",
                  "text": "Parked"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, power_state AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Power State",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "options": {
                "chrgr_sts_connected_charging": {
                  "color": "green",
                  "text": "Charging"
                },
                "chrgr_sts_connected_no_power": {
                  "color": "orange",
                  "text": "Connected (Idle)"
                },
                "chrgr_sts_not_connected": {
                  "color": "text",
                  "text": "Not Connected"
                }
              },
              "type": "value"
            }
          ]
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, charger_status AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Charger Status",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, battery_limit AS value FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Charge Limit",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT name || ' (' || model_year || ' ' || model || ')' AS value FROM vehicles LIMIT 1",
          "refId": "A"
        }
      ],
      "title": "Vehicle",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "pointSize": 4,
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Battery %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Range (mi)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthmi"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, battery_level AS \"Battery %\" FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        },
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, range_km*0.621371 AS \"Range (mi)\" FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "B"
        }
      ],
      "title": "Battery & Range History",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, power_state AS \"Power State\" FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        },
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, charger_status AS \"Charger Status\" FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND $__timeFilter(ts) ORDER BY ts",
          "refId": "B"
        }
      ],
      "title": "Power & Charger State Timeline",
      "type": "state-timeline"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "rivianmate"
  ],
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Overview",
  "uid": "rivianmate-overview",
  "version": 1
}
