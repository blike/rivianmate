{
  "__inputs": [
    {
      "name": "DS_RIVIANMATE",
      "label": "RivianMate Postgres",
      "description": "The Postgres datasource pointing at rivianmate's own database (same DATABASE_URL the app itself uses).",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "description": "Heatmap of everywhere the vehicle has been \u2014 no named places without a geofence table.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rivianmate"
      ],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1001,
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "blur": 15,
              "opacity": 0.6,
              "radius": {
                "fixed": 12
              },
              "weight": {
                "fixed": 0.5
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Visited",
            "type": "heatmap"
          }
        ],
        "view": {
          "id": "fitData",
          "lat": 0,
          "lon": 0,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lat, lon FROM location_points WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 5000",
          "refId": "A"
        }
      ],
      "title": "Visited Areas (Heatmap)",
      "type": "geomap"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 1002,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT end_lat AS \"Latitude\", end_lon AS \"Longitude\", COUNT(*) AS \"Times\" FROM drives WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND end_lat IS NOT NULL GROUP BY end_lat, end_lon ORDER BY COUNT(*) DESC LIMIT 20",
          "refId": "A"
        }
      ],
      "title": "Most Common Drive End Points",
      "type": "table"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "rivianmate"
  ],
  "time": {
    "from": "now-180d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Visited",
  "uid": "rivianmate-visited",
  "version": 1
}
