{
  "__inputs": [
    {
      "name": "DS_RIVIANMATE",
      "label": "RivianMate Postgres",
      "description": "The Postgres datasource pointing at rivianmate's own database (same DATABASE_URL the app itself uses).",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "geomap",
      "name": "Geomap",
      "version": ""
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "description": "Route, speed and battery detail for a single selected drive.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rivianmate"
      ],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "lengthmi"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT distance_km*0.621371 AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Distance",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "m"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(EXTRACT(EPOCH FROM (COALESCE(ended_at, now()) - started_at))/60.0) AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Duration",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((distance_km / NULLIF(EXTRACT(EPOCH FROM (COALESCE(ended_at, now()) - started_at))/3600.0, 0))::numeric, 1) AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Avg Speed",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((start_battery-end_battery)::numeric, 1) AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Battery Used",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT start_battery AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "Start Battery",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT end_battery AS value FROM drives WHERE id=$drive_id",
          "refId": "A"
        }
      ],
      "title": "End Battery",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "speed_kmh"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "continuous-GrYlRd"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 7,
      "options": {
        "basemap": {
          "config": {},
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "style": {
                "color": {
                  "fixed": "#3987e5"
                },
                "opacity": 0.9,
                "width": {
                  "fixed": 3
                }
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Route",
            "type": "route"
          },
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "field": "speed_kmh",
                  "fixed": "dark-green"
                },
                "opacity": 0.7,
                "size": {
                  "fixed": 4
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                }
              }
            },
            "location": {
              "latitude": "lat",
              "longitude": "lon",
              "mode": "coords"
            },
            "name": "Points",
            "type": "markers"
          }
        ],
        "view": {
          "id": "fitData",
          "lat": 0,
          "lon": 0,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT lat, lon, speed_kmh, ts FROM location_points WHERE drive_id=$drive_id ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Route",
      "type": "geomap"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "pointSize": 4,
            "spanNulls": true
          },
          "unit": "velocitykmh"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 8,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, speed_kmh AS \"Speed (km/h)\" FROM location_points WHERE drive_id=$drive_id ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Speed",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "pointSize": 4,
            "spanNulls": true
          },
          "unit": "lengthm"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 9,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, altitude AS \"Altitude (m)\" FROM location_points WHERE drive_id=$drive_id ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Altitude",
      "type": "timeseries"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "rivianmate"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_RIVIANMATE}",
        "definition": "SELECT id AS __value, to_char(started_at, 'YYYY-MM-DD HH24:MI') || ' (' || COALESCE(ROUND(distance_km::numeric,1)::text, '?') || ' km' || CASE WHEN ended_at IS NULL THEN ', in progress)' ELSE ')' END AS __text FROM drives WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) ORDER BY started_at DESC",
        "includeAll": false,
        "label": "Drive",
        "multi": false,
        "name": "drive_id",
        "query": "SELECT id AS __value, to_char(started_at, 'YYYY-MM-DD HH24:MI') || ' (' || COALESCE(ROUND(distance_km::numeric,1)::text, '?') || ' km' || CASE WHEN ended_at IS NULL THEN ', in progress)' ELSE ')' END AS __text FROM drives WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) ORDER BY started_at DESC",
        "refresh": 1,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Drive Details",
  "uid": "rivianmate-drive-details",
  "version": 1
}
