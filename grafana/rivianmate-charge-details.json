{
  "__inputs": [
    {
      "name": "DS_RIVIANMATE",
      "label": "RivianMate Postgres",
      "description": "The Postgres datasource pointing at rivianmate's own database (same DATABASE_URL the app itself uses).",
      "type": "datasource",
      "pluginId": "grafana-postgresql-datasource",
      "pluginName": "PostgreSQL"
    }
  ],
  "__requires": [
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": ""
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": ""
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": ""
    },
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-postgresql-datasource",
      "name": "PostgreSQL",
      "version": "1.0.0"
    }
  ],
  "description": "SoC ramp and power curve for a single selected charging session.",
  "editable": true,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "rivianmate"
      ],
      "targetBlank": false,
      "title": "RivianMate Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "kwatth"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 401,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT energy_kwh AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Energy Added",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "id": 402,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cost AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Cost",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "m"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "id": 403,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(EXTRACT(EPOCH FROM (COALESCE(ended_at, now())-started_at))/60.0) AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Duration",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "kwatt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "id": 404,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg_power_kw AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Avg Power",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "kwatt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "id": 405,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT max_power_kw AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Max Power",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "id": 406,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT (end_soc-start_soc) AS value FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "SoC Gain",
      "type": "stat"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "pointSize": 4,
            "spanNulls": true
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "id": 407,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, battery_level AS \"SoC (%)\" FROM vehicle_state_snapshots WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) AND ts BETWEEN (SELECT started_at FROM charging_sessions WHERE id=$charge_id) AND (SELECT COALESCE(ended_at, now()) FROM charging_sessions WHERE id=$charge_id) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Battery SoC During Session",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "pointSize": 4,
            "spanNulls": true
          },
          "unit": "kwatt"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "id": 408,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT ts AS time, power AS \"Power (kW)\" FROM wallbox_readings WHERE ts BETWEEN (SELECT started_at FROM charging_sessions WHERE id=$charge_id) AND (SELECT COALESCE(ended_at, now()) FROM charging_sessions WHERE id=$charge_id) ORDER BY ts",
          "refId": "A"
        }
      ],
      "title": "Charger Power During Session",
      "type": "timeseries"
    },
    {
      "datasource": "${DS_RIVIANMATE}",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 409,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": "${DS_RIVIANMATE}",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT started_at AS \"Started\", ended_at AS \"Ended\", charger_type AS \"Charger Type\", is_rivian_charger AS \"Rivian Charger\", wallbox_id AS \"Wallbox\", currency AS \"Currency\" FROM charging_sessions WHERE id=$charge_id",
          "refId": "A"
        }
      ],
      "title": "Session Info",
      "type": "table"
    }
  ],
  "refresh": "",
  "schemaVersion": 39,
  "tags": [
    "rivianmate"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": "${DS_RIVIANMATE}",
        "definition": "SELECT id AS __value, to_char(started_at,'YYYY-MM-DD HH24:MI') || ' (' || COALESCE(ROUND(energy_kwh::numeric,1)::text,'?') || ' kWh' || CASE WHEN ended_at IS NULL THEN ', in progress)' ELSE ')' END AS __text FROM charging_sessions WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) ORDER BY started_at DESC",
        "includeAll": false,
        "label": "Session",
        "multi": false,
        "name": "charge_id",
        "query": "SELECT id AS __value, to_char(started_at,'YYYY-MM-DD HH24:MI') || ' (' || COALESCE(ROUND(energy_kwh::numeric,1)::text,'?') || ' kWh' || CASE WHEN ended_at IS NULL THEN ', in progress)' ELSE ')' END AS __text FROM charging_sessions WHERE vehicle_id=(SELECT id FROM vehicles LIMIT 1) ORDER BY started_at DESC",
        "refresh": 1,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-2d",
    "to": "now"
  },
  "timezone": "browser",
  "title": "RivianMate - Charge Details",
  "uid": "rivianmate-charge-details",
  "version": 1
}
