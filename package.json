{
  "name": "rivianmate",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:server",
    "dev:server": "pnpm --filter @rivianmate/server exec node --env-file-if-exists=$PWD/.env --import tsx --watch src/index.ts",
    "dev:web": "pnpm --filter @rivianmate/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript-eslint": "^8.62.1"
  }
}
