{
  "name": "@rivianmate/server",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
