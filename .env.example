# Required: at least 32 random characters. Encrypts Rivian tokens and signs sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Postgres password for the bundled database (defaults to "rivianmate" if unset)
POSTGRES_PASSWORD=

# Optional: host port for the app (defaults to 4000)
# APP_PORT=4000

# Optional: how much to log (fatal, error, warn, info, debug; defaults to info).
# debug adds every HTTP request and routine live-stream renewals.
# LOG_LEVEL=info

# Optional: pretty (readable, the default) or json (one object per line, for log collectors)
# LOG_FORMAT=pretty

# Optional: time zone for times mentioned in log messages, e.g. America/Los_Angeles (defaults to UTC)
# TZ=UTC

# --- Local development only (pnpm dev) ---
# DATABASE_URL=postgres://rivianmate:rivianmate@localhost:5433/rivianmate
# MOCK_RIVIAN=1
