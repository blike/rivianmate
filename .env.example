# Required: at least 32 random characters. Encrypts Rivian tokens and signs sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Postgres password for the bundled database (defaults to "rivianmate" if unset)
POSTGRES_PASSWORD=

# Optional: host port for the app (defaults to 4000)
# APP_PORT=4000

# --- Local development only (pnpm dev) ---
# DATABASE_URL=postgres://rivianmate:rivianmate@localhost:5433/rivianmate
# MOCK_RIVIAN=1
