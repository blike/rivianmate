# Required: at least 32 random characters; encrypts Rivian tokens and signs sessions.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Postgres password used by docker-compose (defaults to "rivianmate" if unset)
POSTGRES_PASSWORD=

# Host port for local development database access (defaults to 5433)
POSTGRES_PORT=5433

# Host port for the app (defaults to 4000)
APP_PORT=4000

# --- Local development only ---
# DATABASE_URL=postgres://rivianmate:rivianmate@localhost:5433/rivianmate
# Run against a simulated vehicle instead of the real Rivian cloud (OTP is 000000)
# MOCK_RIVIAN=1
# Optional: seed the app password on first boot instead of using the setup wizard
# APP_PASSWORD=

# Pin a published release (defaults to latest)
# RIVIANMATE_VERSION=0.3
